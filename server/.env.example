# MongoDB Atlas connection string from Atlas > Connect > Drivers.
# The backend explicitly selects the petlostapp database.
MONGODB_URI=your_mongodb_atlas_connection_string
PORT=5000
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Keep false for direct local development. In production, use an explicit
# trusted proxy subnet/address where possible; a controlled hop count is also accepted.
TRUST_PROXY=false
ALLOW_DESTRUCTIVE_SEED=false
ALLOW_TEST_SEED=false
SEED_USER_PASSWORD=choose_a_local_test_password

# Phase 1 managed storage (backend values only; no VITE_ credentials).
# Existing forms still use the legacy image path until Phase 2 is approved.
IMAGE_STORAGE_PROVIDER=cloudinary
IMAGE_UPLOADS_ENABLED=false
MEDIA_NAMESPACE=petlostapp/dev
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Migration and abandoned-upload cleanup are not implemented/enabled in Phase 1.
ALLOW_IMAGE_MIGRATION=false
ALLOW_IMAGE_CLEANUP=false
