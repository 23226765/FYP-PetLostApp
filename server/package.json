{
  "name": "pawradar-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "seed": "node seed.js",
    "seed:test": "node scripts/seedTestData.js",
    "seed:clean": "node scripts/cleanTestSeed.js",
    "seed:verify": "node scripts/verifySeedApis.js",
    "verify:bugfixes": "node scripts/verifyBugFixes.js",
    "verify:privacy": "node scripts/verifyContactPrivacy.js",
    "verify:sightings": "node scripts/verifySightingWorkflow.js",
    "verify:strays": "node scripts/verifyStrayCommunity.js",
    "verify:preferences": "node scripts/verifyPreferences.js",
    "verify:db": "node scripts/verifyDatabase.js",
    "verify:images": "node scripts/verifyImageStorage.js",
    "test": "node --test tests/*.test.js",
    "test:transactions": "node scripts/testTransactions.js",
    "verify:images:e2e": "node scripts/testTransactions.js --cloudinary --confirm-isolated-cloudinary-writes",
    "media:reconcile": "node scripts/reconcileManagedImages.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.6.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "11.3.0",
    "nodemon": "^3.1.4"
  }
}
